---
/** Pointed-bottom hexagon with an UP triangle cutout and a 45% triangle centered at its centroid. Matches public/favicon.svg. */
import { brandMark } from "../lib/brand";
---

<svg
  class="brand-mark-svg"
  xmlns="http://www.w3.org/2000/svg"
  viewBox={brandMark.viewBox}
  fill="currentColor"
  aria-hidden="true"
>
  <path
    fill-rule="evenodd"
    d={brandMark.outline}
  ></path>
  <path d={brandMark.center}></path>
</svg>
