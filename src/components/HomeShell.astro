---
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import Loc from "./Loc.astro";
import DirectoryCard from "./DirectoryCard.astro";
import GitHubStar from "./GitHubStar.astro";
import { sections, entries, sectionEntries, tasks } from "../lib/directory";
import { starterCases } from "../lib/starters";
import { changelogNotes } from "../lib/cases";
import { withBase, assetUrl } from "../lib/paths";
import { shanghaiDateKey } from "../lib/format";
interface Props { dateKey?: string; }
const { dateKey } = Astro.props;
const recent = dateKey ? entries.filter(entry => shanghaiDateKey(entry.updatedAt) === dateKey) : entries.slice(0, 12);
const starters = starterCases().map(item => entries.find(entry => entry.key === `grok:${item.id}`)!).filter(Boolean);
const archive = [...new Set(changelogNotes.map(note => note.date))].sort((a, b) => b.localeCompare(a)).slice(0, 8);
---
<Header />
<main class="directory-home wrap-wide">
  <section class="directory-home-hero">
    <p class="kicker">AI UP LAB</p>
    <h1><Loc zh="把 AI 用到你的下一件事里" en="Put AI to work on your next task" /></h1>
    <p class="lede"><Loc zh="从教程学方法，用工具做事情，拿范例开始创作。跟进模型能力，也保留值得长期复用的经验。" en="Learn a method, find a tool, or start from an example. Follow new capabilities and keep practices worth reusing." /></p>
    <form class="directory-home-search" action={withBase("search/")} role="search"><label class="sr-only" for="home-q"><Loc zh="搜索全部资源" en="Search all resources" /></label><input id="home-q" name="q" type="search" placeholder="你想用 AI 完成什么？" data-ph-zh="你想用 AI 完成什么？" data-ph-en="What do you want to do with AI?" /><button class="btn btn-primary" type="submit"><Loc zh="找用法" en="Find a resource" /></button></form>
    <div class="directory-task-links">{tasks.map(task => <a href={withBase(`search/?task=${task.id}`)}><Loc zh={task.title.zh} en={task.title.en} /></a>)}</div>
  </section>
  <section class="directory-section-row" aria-label="目录 / Directory">
    {sections.map(section => <a class:list={["directory-section-card", `tone-${section.tone}`]} href={withBase(`${section.id}/`)}><img src={assetUrl(section.image)} alt="" width="168" height="112" /><div><h2><Loc zh={section.title.zh} en={section.title.en} /></h2><p><Loc zh={section.description.zh} en={section.description.en} /></p><span><Loc zh={`${sectionEntries(section.id).length} 条资源 →`} en={`${sectionEntries(section.id).length} resources →`} /></span></div></a>)}
  </section>
  {!dateKey && <section class="directory-home-section"><div class="directory-section-heading"><div><p class="kicker">START HERE</p><h2><Loc zh="新手从这里开始" en="Start here" /></h2></div><a href={withBase("learn/?difficulty=starter")}><Loc zh="更多入门教程 →" en="More starter guides →" /></a></div><div class="directory-grid directory-starters">{starters.map(entry => <DirectoryCard entry={entry} />)}</div></section>}
  <section class="directory-home-section"><div class="directory-section-heading"><div><p class="kicker">KEEP EXPLORING</p><h2><Loc zh={dateKey ? `${dateKey} 的更新` : "最近更新"} en={dateKey ? `Updates for ${dateKey}` : "Recently updated"} /></h2></div><a href={withBase("search/?sort=latest")}><Loc zh="查看全部 →" en="Browse all →" /></a></div><div class="directory-grid">{recent.map(entry => <DirectoryCard entry={entry} />)}</div>{!recent.length && <p><Loc zh="这一天没有新增资源，看看其他日期或探索目录。" en="No new resources on this date. Explore another day or a section." /></p>}</section>
  <section class="directory-home-archive"><h2><Loc zh="按日期回看" en="Browse past updates" /></h2><div class="directory-task-links">{archive.map(date => <a href={withBase(`d/${date}/`)}>{date}</a>)}<a href={withBase("changelog/")}><Loc zh="全部更新记录 →" en="All update notes →" /></a></div></section>
  <GitHubStar variant="rail" />
</main>
<Footer />
