---
import GitHubStar from "./GitHubStar.astro";
import Loc from "./Loc.astro";
import { sections } from "../lib/directory";
import { withBase } from "../lib/paths";
import { siteName, siteTagline, siteTaglineEn } from "../lib/site";
---
<footer class="site-footer">
  <div class="wrap-wide directory-footer">
    <div><strong>{siteName}</strong><p><Loc zh={siteTagline} en={siteTaglineEn} /></p><p class="disclaimer"><Loc zh="独立整理的 AI 实践资源。每条附来源；能力和效果以原文与实际使用为准。" en="An independent collection of AI resources. Every entry links to its source; check claims against the original and your own use." /></p><GitHubStar variant="line" /></div>
    <div><strong><Loc zh="按你想做的事探索" en="Explore by purpose" /></strong><div class="footer-links">{sections.map(section => <a href={withBase(`${section.id}/`)}><Loc zh={section.title.zh} en={section.title.en} /></a>)}</div></div>
    <div><strong><Loc zh="关于与更多" en="About & more" /></strong><div class="footer-links"><a href={withBase("about/")}><Loc zh="关于与收录标准" en="About & editorial standards" /></a><a href={withBase("brand/")}><Loc zh="品牌与界面规范" en="Brand guidelines" /></a><a href={withBase("brand-collection/")}><Loc zh="品牌收集" en="Brand collection" /></a><a href={withBase("changelog/")}><Loc zh="更新日志" en="Changelog" /></a><a href={withBase("search/")}><Loc zh="全站搜索" en="Search everything" /></a><a href={withBase("cases/")}><Loc zh="全部教程与案例" en="All guides & cases" /></a><a href={withBase("html/")}><Loc zh="全部网页资源" en="All web resources" /></a><a href={withBase("agent-ui/")}><Loc zh="全部界面组件" en="All UI components" /></a></div></div>
  </div>
</footer>
