---
import BrandMark from "./BrandMark.astro";
import GitHubStar from "./GitHubStar.astro";
import Loc from "./Loc.astro";
import Icon from "./Icon.astro";
import { sections, entries } from "../lib/directory";
import { withBase, isSectionPath, isCurrentPath } from "../lib/paths";
import { ui } from "../lib/i18n";
import { siteName, siteTagline, siteTaglineEn } from "../lib/site";
const path = Astro.url.pathname;
const currentEntry = entries.find(entry => isCurrentPath(path, entry.href));
const active = currentEntry?.sections[0] ?? sections.find(section => isSectionPath(path, withBase(`${section.id}/`)))?.id;
---
<header class="site-header directory-header">
  <div class="wrap-wide directory-header-top">
    <a class="brand" href={withBase("/")}><span class="brand-mark" aria-hidden="true"><BrandMark /></span><span class="brand-text"><strong>{siteName}</strong><span><Loc zh={siteTagline} en={siteTaglineEn} /></span></span></a>
    <nav class="directory-nav" aria-label="目录 / Directory">
      <a href={withBase("/")} aria-current={isCurrentPath(path, withBase("/")) ? "page" : undefined}><Loc zh="首页" en="Home" /></a>
      {sections.map(section => <a href={withBase(`${section.id}/`)} aria-current={active === section.id ? "page" : undefined}><Loc zh={section.title.zh} en={section.title.en} /></a>)}
    </nav>
    <div class="directory-header-tools">
      <a href={withBase("favorites/")}><Loc zh="收藏" en="Saved" /><span class="fav-count" data-fav-count hidden aria-hidden="true"></span></a>
      <details class="directory-header-more">
        <summary><Loc zh="更多" en="More" /><Icon name="caret" size={12} /></summary>
        <nav class="directory-more-menu" aria-label="更多 / More">
          <a href={withBase("search/")}><Loc zh="搜索资源" en="Search resources" /></a>
          <a class="directory-more-saved" href={withBase("favorites/")}><Loc zh="我的收藏" en="Saved resources" /><span class="fav-count" data-fav-count hidden aria-hidden="true"></span></a>
          <a href={withBase("changelog/")}><Loc zh="更新记录" en="Update notes" /></a>
          <a href={withBase("about/")}><Loc zh="关于本站" en="About" /></a>
          <a href={withBase("brand/")}><Loc zh="品牌与界面规范" en="Brand guidelines" /></a>
        </nav>
      </details>
      <GitHubStar variant="pill" />
      <div class="locale-toggle" role="group" aria-label="语言 / Language"><button type="button" data-locale-set="zh" aria-pressed="true">ZH</button><span aria-hidden="true">|</span><button type="button" data-locale-set="en" aria-pressed="false">EN</button></div>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label={ui.header.theme.zh} data-aria-zh={ui.header.theme.zh} data-aria-en={ui.header.theme.en}><Icon name="theme" size={18} /></button>
    </div>
  </div>
</header>
<script>
  const more = document.querySelector<HTMLDetailsElement>(".directory-header-more");
  document.addEventListener("click", event => {
    if (event.target instanceof Node && !more?.contains(event.target)) more?.removeAttribute("open");
  });
  document.addEventListener("keydown", event => {
    if (event.key === "Escape" && more?.open) {
      more.removeAttribute("open");
      more.querySelector("summary")?.focus();
    }
  });
  document.querySelectorAll<HTMLButtonElement>("[data-locale-set]").forEach(button => button.addEventListener("click", () => {
    const apply = (window as Window & { __applyLocale?: (locale: string, persist?: boolean) => void }).__applyLocale;
    apply?.(button.dataset.localeSet === "en" ? "en" : "zh", true);
  }));
  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem("theme", next); } catch {}
  });
</script>
