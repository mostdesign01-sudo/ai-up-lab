---
import BaseLayout from "../layouts/BaseLayout.astro";
import DirectoryListing from "../components/DirectoryListing.astro";
import Loc from "../components/Loc.astro";
import { sections } from "../lib/directory";
import { withBase } from "../lib/paths";
export function getStaticPaths() {
  return sections.filter(section => section.id !== "models").map(section => ({ params: { section: section.id }, props: { section } }));
}
const { section } = Astro.props;
---
<BaseLayout title={`${section.title.zh} · AI UP LAB`} titleEn={`${section.title.en} · AI UP LAB`} description={section.description.zh} descriptionEn={section.description.en}>
  <div class="wrap-wide directory-page">
    <section class="collection-hero"><h1><Loc zh={section.title.zh} en={section.title.en} /></h1><p class="lede"><Loc zh={section.description.zh} en={section.description.en} /></p>{section.id === "tools" && <p class="section-callout"><a href={withBase("image-tools/")}><Loc zh="打开站内图片工具" en="Open the on-site image tool" /></a><Loc zh="：在浏览器里抠图、换背景、放大，照片留在本机。" en=": cut out, replace a background, and upscale in the browser. Photos stay on this device." /></p>}</section>
    <DirectoryListing section={section.id} />
  </div>
</BaseLayout>
