---
import BaseLayout from "../layouts/BaseLayout.astro";
import DirectoryListing from "../components/DirectoryListing.astro";
import Loc from "../components/Loc.astro";
import PromptGallery from "../components/PromptGallery.astro";
import { sections } from "../lib/directory";
import { promptsSectionBoardCards } from "../lib/prompt-board";
import { withBase } from "../lib/paths";
export function getStaticPaths() {
  return sections.filter(section => section.id !== "models").map(section => ({ params: { section: section.id }, props: { section } }));
}
const { section } = Astro.props;
const promptCards = section.id === "prompts" ? promptsSectionBoardCards() : [];
---
<BaseLayout title={`${section.title.zh} · AI UP LAB`} titleEn={`${section.title.en} · AI UP LAB`} description={section.description.zh} descriptionEn={section.description.en}>
  <div class="wrap-wide directory-page">
    <section class="collection-hero"><h1><Loc zh={section.title.zh} en={section.title.en} /></h1><p class="lede"><Loc zh={section.description.zh} en={section.description.en} /></p></section>
    {
      section.id === "prompts" ? (
        <PromptGallery cards={promptCards} searchUrl={withBase("search/")} sectionId="prompts" />
      ) : (
        <DirectoryListing section={section.id} />
      )
    }
  </div>
</BaseLayout>
