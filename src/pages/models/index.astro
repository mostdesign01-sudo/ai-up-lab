---
import DirectoryCard from "../../components/DirectoryCard.astro";
import Loc from "../../components/Loc.astro";
import ModelCard from "../../components/ModelCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sectionEntries, sections } from "../../lib/directory";
import { ui } from "../../lib/i18n";
import { listModels } from "../../lib/models";

const section = sections.find(section => section.id === "models")!;
const listed = listModels();
// Launch news that a model page links to is filed here too.
const related = sectionEntries("models").filter(entry => entry.lib !== "models");
---

<BaseLayout
  title={ui.model.indexTitle.zh}
  titleEn={ui.model.indexTitle.en}
  description={ui.model.indexDesc.zh}
  descriptionEn={ui.model.indexDesc.en}
>
  <div class="wrap-wide directory-page">
    <section class="collection-hero">
      <h1><Loc zh={section.title.zh} en={section.title.en} /></h1>
      <p class="lede"><Loc zh={ui.model.indexLede.zh} en={ui.model.indexLede.en} /></p>
    </section>
    <p class="count-row"><Loc zh={`共 ${listed.length} 个模型 · 精选在前`} en={`${listed.length} models · Featured first`} /></p>
    <div class="model-grid model-grid--directory" aria-label={ui.model.list.zh} data-aria-zh={ui.model.list.zh} data-aria-en={ui.model.list.en}>
      {listed.map((model) => <ModelCard model={model} />)}
    </div>
    {related.length > 0 && (
      <section class="directory-related" aria-labelledby="models-related">
        <h2 id="models-related"><Loc zh="相关资讯" en="Related news" /></h2>
        <div class="directory-grid">{related.map(entry => <DirectoryCard entry={entry} />)}</div>
      </section>
    )}
  </div>
</BaseLayout>
