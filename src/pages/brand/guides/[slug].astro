---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Loc from "../../../components/Loc.astro";
import BrandDocsNav from "../../../components/BrandDocsNav.astro";
import BrandSpecDemo from "../../../components/BrandSpecDemo.astro";
import { designKnowledge, designGroups, specMarkdown, referenceBase } from "../../../lib/design-knowledge";
import { designSystemVersion } from "../../../lib/design-system";
import { withBase } from "../../../lib/paths";
import "../../../styles/brand-guide.css";
import "../../../styles/brand-handbook.css";
export function getStaticPaths() { return designKnowledge.map(spec => ({params:{slug:spec.id},props:{spec}})); }
const { spec } = Astro.props;
const group=designGroups.find(group=>group.id===spec.group)!;
const codeBase="https://github.com/mostdesign01-sudo/grokbot-use-cases/blob/codex/simplify-category-pages/";
---
<BaseLayout title={`${spec.title.zh} · AI UP LAB 设计规范`} titleEn={`${spec.title.en} · AI UP LAB design system`} description={spec.definition.zh} descriptionEn={spec.definition.en}>
<div class="wrap-wide brand-guide handbook-shell"><BrandDocsNav active={spec.id} /><article class="handbook-content">
<header class="spec-header"><p class="brand-guide-kicker"><Loc {...group.title} /> / v{designSystemVersion}</p><h1><Loc {...spec.title} /></h1><p class="brand-guide-intro"><Loc {...spec.definition} /></p><div class="brand-guide-actions"><a class="brand-guide-primary" href="#example"><Loc zh="查看示例" en="Explore example" /></a><button class="brand-guide-secondary" type="button" data-spec-copy><Loc zh="复制本项规则" en="Copy rules" /></button><a class="brand-guide-link" href={withBase(`brand/rules/${spec.id}.md`)} download={`ai-up-lab-${spec.id}.md`}>Markdown ↓</a></div><p role="status" data-spec-status></p></header>
<nav class="spec-local-nav" aria-label="On this page"><a href="#example"><Loc zh="示例" en="Example" /></a><a href="#rules"><Loc zh="结构与规则" en="Rules" /></a><a href="#states"><Loc zh="参数与状态" en="States" /></a><a href="#implementation"><Loc zh="代码与 AI" en="Code & AI" /></a><a href="#acceptance"><Loc zh="验收" en="Review" /></a></nav>
<section id="example" class="spec-section"><h2><Loc zh="实际示例" en="Working example" /></h2><BrandSpecDemo spec={spec} /></section>
<section id="rules" class="spec-section"><h2><Loc zh="组成与使用规则" en="Anatomy & usage" /></h2><ol class="spec-anatomy">{spec.anatomy.map((item,index)=><li><span class="spec-number">{String(index+1).padStart(2,"0")}</span><Loc {...item} /></li>)}</ol><h3><Loc zh="必须遵守" en="Required behavior" /></h3><ul class="spec-rule-list">{spec.rules.map(rule=><li><Loc {...rule} /></li>)}</ul><div class="handbook-pair spec-comparison"><article><h3><Loc zh="推荐做法" en="Do" /></h3><p><Loc {...spec.good} /></p></article><article><h3><Loc zh="避免做法" en="Avoid" /></h3><p><Loc {...spec.bad} /></p></article></div></section>
<section id="states" class="spec-section"><h2><Loc zh="参数与状态" en="Parameters & states" /></h2><div class="spec-table-wrap"><table><thead><tr><th><Loc zh="参数" en="Parameter" /></th><th><Loc zh="取值" en="Value" /></th><th><Loc zh="用法" en="Usage" /></th></tr></thead><tbody>{spec.parameters.map(param=><tr><th><code>{param.name}</code></th><td><code>{param.value}</code></td><td><Loc {...param.usage} /></td></tr>)}</tbody></table></div><div class="spec-states">{spec.states.map(state=><article><h3><Loc {...state.name} /></h3><p><Loc {...state.behavior} /></p></article>)}</div></section>
<section id="implementation" class="spec-section"><h2><Loc zh="代码映射与 AI 使用" en="Code mapping & AI use" /></h2><p><Loc zh="先读取本项规则，再通过下列映射找到已有实现。调整共用组件时，同步检查依赖项。" en="Read these rules, then locate the existing implementation below. Check dependencies when changing shared components." /></p><div class="spec-code-map">{spec.code.map(ref=><a href={`${codeBase}${ref.path}`} target="_blank" rel="noopener noreferrer"><code>{ref.path}</code><Loc {...ref.purpose} /> ↗</a>)}</div><h3><Loc zh="实现片段" en="Implementation fragment" /></h3><p class="brand-guide-note"><Loc zh="组件片段需放入相应 Astro 文件上下文，按代码映射补齐导入。" en="Place component fragments in the corresponding Astro context and complete imports from the code mappings." /></p><pre class="spec-code"><code>{spec.snippet}</code></pre>{spec.tokens.length>0&&<><h3><Loc zh="使用的设计变量" en="Design tokens" /></h3><div class="spec-token-list">{spec.tokens.map(token=><code>{token}</code>)}</div></>}{spec.dependencies.length>0&&<><h3><Loc zh="相关规则" en="Related rules" /></h3><div class="spec-dependencies">{spec.dependencies.map(id=>{const item=designKnowledge.find(item=>item.id===id)!;return <a href={withBase(`brand/guides/${id}/`)}><Loc {...item.title} /> →</a>})}</div></>}<details class="brand-guide-brief"><summary><Loc zh="给 AI 的完整规则文本" en="Full rules for AI" /></summary><pre data-spec-markdown>{specMarkdown(spec)}</pre></details><a class="brand-guide-link" href={withBase("brand/guides/ai-workflow/#example")}><Loc zh="按任务整理 AI 工作说明 →" en="Assemble a task-specific brief →" /></a></section>
<section id="acceptance" class="spec-section"><h2><Loc zh="交付前检查" en="Before delivery" /></h2><ul class="spec-rule-list">{spec.checks.map(check=><li><Loc {...check} /></li>)}</ul><div class="spec-reference"><h3><Loc zh="方法参考与适用边界" en="Reference & scope" /></h3><p><Loc zh="参考 Tmall Design 将规则、映射与代码关联的组织方法。本页参数、示例和品牌资产为 AI UP LAB 自身规范。" en="Inspired by Tmall Design’s organization of rules, mappings, and code. Parameters, examples, and brand assets here are specific to AI UP LAB." /></p><a href={`${referenceBase}#${spec.reference}`} target="_blank" rel="noopener noreferrer">Tmall Design ↗</a></div></section>
</article></div>
</BaseLayout>
<script>
document.querySelector("[data-spec-copy]")?.addEventListener("click",async()=>{const status=document.querySelector<HTMLElement>("[data-spec-status]")!;const english=document.documentElement.dataset.locale==="en";try{await navigator.clipboard.writeText(document.querySelector("[data-spec-markdown]")!.textContent!);status.textContent=english?"Rules copied.":"已复制本项完整规则。";}catch{document.querySelector(".brand-guide-brief")?.setAttribute("open","");status.textContent=english?"Select the expanded rules or download Markdown.":"请复制展开的规则文本，或下载 Markdown。";}});
</script>
