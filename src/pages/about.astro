---
import BaseLayout from "../layouts/BaseLayout.astro";
import Loc from "../components/Loc.astro";
import { sections } from "../lib/directory";
import { withBase } from "../lib/paths";
---
<BaseLayout title="关于与收录标准 · AI UP LAB" titleEn="About & editorial standards · AI UP LAB">
  <div class="wrap directory-page">
    <section class="collection-hero"><p class="kicker">AI UP LAB</p><h1><Loc zh="让 AI 的新能力变成可用的方法" en="Turn AI capabilities into useful practice" /></h1><p class="lede"><Loc zh="从 Grok Bot 用法开始，逐步整理跨产品、跨模型的 AI 实践资源。按你想完成的事情探索，产品名和版本留在具体条目里。" en="Started with Grok Bot use cases, now growing into practical resources across products and models. Explore by what you want to do; product names and versions stay on individual entries." /></p></section>
    <section class="section"><h2><Loc zh="我们整理什么" en="What we collect" /></h2><div class="footer-links">{sections.map(section => <p><a href={withBase(`${section.id}/`)}><Loc zh={section.title.zh} en={section.title.en} /></a> — <Loc zh={section.description.zh} en={section.description.en} /></p>)}</div></section>
    <section class="section"><h2><Loc zh="什么值得收录" en="What earns a place" /></h2><p><Loc zh="有明确用途、真实可打开的来源，以及读者能理解的获取方式与限制。优先收录可复用的教程、工具和范例；模型发布应说明能力变化及实践入口。" en="A clear purpose, a real source, and understandable access requirements and limits. Reusable guides, tools, and examples come first; model releases should explain capability changes and how to try them." /></p><p><Loc zh="模型整理的摘要与推荐理由属于编辑草稿。来源核对不等于操作实测，作者声称不等于独立验证；条目中的推荐星级也不是模型基准排名。" en="Model-written summaries and recommendations are editorial drafts. Checking a source does not mean testing a workflow, and an author's claim is not independent verification. Editorial stars are not benchmark rankings." /></p></section>
    <section class="section"><h2><Loc zh="如何阅读来源与日期" en="Read sources and dates carefully" /></h2><p><Loc zh="每条资源链接到原文。收录与更新日期表示本站整理时间，不保证原产品仍免费或功能始终不变。重要步骤请对照最新官方文档；遇到失效或变化，可以通过仓库 Issue 提醒我们。" en="Every resource links to its original. Listing and update dates describe our editorial work; they do not guarantee permanent pricing or features. Check current official docs and report stale entries through a repository Issue." /></p></section>
  </div>
</BaseLayout>
