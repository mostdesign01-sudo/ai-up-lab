---
import Loc from "../../components/Loc.astro";
import PromptGallery from "../../components/PromptGallery.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ui } from "../../lib/i18n";
import { imagePromptBoardCards } from "../../lib/prompt-board";
import { withBase } from "../../lib/paths";

const cards = imagePromptBoardCards();
---

<BaseLayout noindex="follow"
  collection="lab"
  title={ui.imagePrompt.indexTitle.zh}
  titleEn={ui.imagePrompt.indexTitle.en}
  description={ui.imagePrompt.indexDesc.zh}
  descriptionEn={ui.imagePrompt.indexDesc.en}
>
  <div class="wrap-wide">
    <header class="prompt-library-intro">
      <p class="kicker"><Loc zh={ui.imagePrompt.kicker.zh} en={ui.imagePrompt.kicker.en} /></p>
      <h1><Loc zh={ui.imagePrompt.indexH1.zh} en={ui.imagePrompt.indexH1.en} /></h1>
      <p class="lede"><Loc zh={ui.imagePrompt.indexLede.zh} en={ui.imagePrompt.indexLede.en} /></p>
      <p class="combo-tease">
        <Loc zh={ui.imagePrompt.modelsTease.zh} en={ui.imagePrompt.modelsTease.en} />
        {" "}
        <a href={withBase("models/")}><Loc zh={ui.nav.models.zh} en={ui.nav.models.en} /></a>
      </p>
    </header>
    <PromptGallery cards={cards} />
  </div>
</BaseLayout>
